# YagzShoes Enterprise POS — Ortam Değişkenleri
# Bu dosyayı .gitignore'a ekleyin. Production'da güçlü bir secret kullanın.
# Minimum 32 karakter, rastgele oluşturulmuş olmalı.

# JWT İmzalama Anahtarı (eksikse uygulama başlamaz)
JWT_SECRET=

# Uygulama Portu (varsayılan 3000)
PORT=3000

# Ortam (development | production)
NODE_ENV=development
